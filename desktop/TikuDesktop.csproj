<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TikuDesktop</AssemblyName>
    <RootNamespace>TikuDesktop</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>计算机程序设计员（四级）题库</AssemblyTitle>
    <Product>计算机程序设计员（四级）题库</Product>
    <Company>xk464</Company>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Copyright>© 2026 xk464</Copyright>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="web\index.html" LogicalName="web/index.html" />
    <EmbeddedResource Include="web\assets\bank.js" LogicalName="web/assets/bank.js" />
    <EmbeddedResource Include="web\assets\favicon.png" LogicalName="web/assets/favicon.png" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="tcc.zip" LogicalName="tcc.zip" />
    <EmbeddedResource Include="tcc-COPYING.txt" LogicalName="tcc-COPYING.txt" />
  </ItemGroup>

</Project>
